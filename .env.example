# Copie para .env (ignorado pelo git). Valores não secretos.
# Pasta com os parquet da camada gold (relativa ao diretório de execução)
CANAVIS_DATA_DIR=data/processed
# Build estático do React servido pela API (na imagem Docker: /app/static)
CANAVIS_STATIC_DIR=apps/web/dist
# Snapshots das fontes internacionais lidos pela API (gerados por canavis-intl refresh)
CANAVIS_EXTERNAL_DIR=data/external
# Nenhuma fonte internacional exige chave de API; não coloque segredos neste arquivo
# Modo ao vivo (BCB e Yahoo) com cache em memória e fallback para o snapshot. Desligado por padrão.
CANAVIS_INTL_LIVE=0
CANAVIS_SOURCES_FILE=config/sources.yaml
