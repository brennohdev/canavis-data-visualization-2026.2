# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.DS_Store

# Virtual environments
.venv

# Dados do pipeline: versionamos os parquet (compactos), ignoramos CSV volumoso
data/**/*.csv
!data/samples/*.csv

# Artefatos de compilação LaTeX
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# Jupyter
.ipynb_checkpoints/

# Artefatos de workflow de agentes (review.json, pr.json, etc.)
.agents/

# Node e artefatos do web
node_modules/
apps/web/dist/

# Configuração local (nunca versionar)
.env
