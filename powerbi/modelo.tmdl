createOrReplace

	table fato_producao
		column territorio_id
			dataType: string
			summarizeBy: none
			sourceColumn: territorio_id

		column data_referencia
			dataType: dateTime
			summarizeBy: none
			sourceColumn: data_referencia

		column fonte_id
			dataType: string
			summarizeBy: none
			sourceColumn: fonte_id

		column nivel_territorial
			dataType: string
			summarizeBy: none
			sourceColumn: nivel_territorial

		column ano_referencia
			dataType: int64
			summarizeBy: none
			sourceColumn: ano_referencia

		column quantidade_produzida_t
			dataType: double
			summarizeBy: none
			sourceColumn: quantidade_produzida_t

		column area_colhida_ha
			dataType: double
			summarizeBy: none
			sourceColumn: area_colhida_ha

		column produtividade_t_ha
			dataType: double
			summarizeBy: none
			sourceColumn: produtividade_t_ha

		column situacao_quantidade
			dataType: string
			summarizeBy: none
			sourceColumn: situacao_quantidade

		column situacao_area
			dataType: string
			summarizeBy: none
			sourceColumn: situacao_area

		column tendencia_t_ha
			dataType: double
			summarizeBy: none
			sourceColumn: tendencia_t_ha

		column oscilacao_t_ha
			dataType: double
			summarizeBy: none
			sourceColumn: oscilacao_t_ha

		column f_chow
			dataType: double
			summarizeBy: none
			sourceColumn: f_chow

		column p_chow
			dataType: double
			summarizeBy: none
			sourceColumn: p_chow

		column status_chow
			dataType: string
			summarizeBy: none
			sourceColumn: status_chow

		column ponto_candidato_quebra
			dataType: boolean
			summarizeBy: none
			sourceColumn: ponto_candidato_quebra

		column quebra_confirmada
			dataType: boolean
			summarizeBy: none
			sourceColumn: quebra_confirmada

		/// Rendimento medio ponderado pela area (razao de agregados: soma da quantidade / soma da area), nao a media simples das produtividades. Exige nivel unico.
		measure 'Produtividade' = IF(HASONEVALUE(dim_territorio[nivel_territorial]) && COUNTROWS(FILTER(fato_producao, ISBLANK(fato_producao[quantidade_produzida_t]) || ISBLANK(fato_producao[area_colhida_ha]))) = 0, DIVIDE(SUM(fato_producao[quantidade_produzida_t]), SUM(fato_producao[area_colhida_ha])))
			formatString: 0.00

		/// Participacao do territorio no total do SEU nivel (denominador por nivel). So e valida com nivel fixado; nunca em ranking multinivel.
		measure 'Participação regional' = VAR Nivel = SELECTEDVALUE(dim_territorio[nivel_territorial]) VAR Quantidade = IF(COUNTROWS(FILTER(fato_producao, ISBLANK(fato_producao[quantidade_produzida_t]))) = 0, SUM(fato_producao[quantidade_produzida_t])) VAR Total = CALCULATE(IF(COUNTROWS(FILTER(fato_producao, ISBLANK(fato_producao[quantidade_produzida_t]))) = 0, SUM(fato_producao[quantidade_produzida_t])), ALL(dim_territorio), dim_territorio[nivel_territorial] = Nivel) RETURN IF(NOT ISBLANK(Nivel) && NOT ISBLANK(Quantidade), DIVIDE(Quantidade, Total))
			formatString: 0.00%

		/// Desvio percentual da produtividade frente a referencia = a selecao visivel no visual (nao o Brasil, nao uma media fixa). Fixar nivel.
		measure 'Desvio vs seleção' = VAR Atual = [Produtividade] VAR Referencia = CALCULATE([Produtividade], ALLSELECTED(dim_territorio)) RETURN IF(NOT ISBLANK(Atual) && NOT ISBLANK(Referencia), DIVIDE(Atual - Referencia, Referencia))
			formatString: 0.00%

		/// Desvio frente as UFs do mesmo tier (ADR 0006). Exclusiva do nivel UF; retorna vazio fora dele por construcao, nao e erro.
		measure 'Desvio vs grupo' = VAR Tier = SELECTEDVALUE(dim_territorio[tier]) VAR Atual = [Produtividade] VAR Referencia = CALCULATE([Produtividade], ALLSELECTED(dim_territorio), KEEPFILTERS(dim_territorio[tier] = Tier)) RETURN IF(NOT ISBLANK(Tier) && NOT ISBLANK(Atual) && NOT ISBLANK(Referencia), DIVIDE(Atual - Referencia, Referencia))
			formatString: 0.00%

		measure 'Tendência histórica (t por ha)' = IF(HASONEVALUE(dim_territorio[territorio_id]) && HASONEVALUE(dim_calendario[ano]), MAX(fato_producao[tendencia_t_ha]))
			formatString: 0.00

		measure 'Oscilação histórica (t por ha)' = IF(HASONEVALUE(dim_territorio[territorio_id]) && HASONEVALUE(dim_calendario[ano]), MAX(fato_producao[oscilacao_t_ha]))
			formatString: 0.00

		measure 'P Chow exploratório (2003-2023)' = IF(HASONEVALUE(dim_territorio[territorio_id]), MAX(fato_producao[p_chow]))
			formatString: 0.000000

		partition fato_producao = m
			mode: import
			source =
				Parquet.Document(Web.Contents("https://raw.githubusercontent.com/brennohdev/canavis-data-visualization-2026.2/main/data/processed/fato_producao.parquet"))

	table fato_industria
		column territorio_id
			dataType: string
			summarizeBy: none
			sourceColumn: territorio_id

		column uf
			dataType: string
			summarizeBy: none
			sourceColumn: uf

		column safra
			dataType: string
			summarizeBy: none
			sourceColumn: safra

		column ano_alinhamento
			dataType: int64
			summarizeBy: none
			sourceColumn: ano_alinhamento

		column data_referencia
			dataType: dateTime
			summarizeBy: none
			sourceColumn: data_referencia

		column fonte_id
			dataType: string
			summarizeBy: none
			sourceColumn: fonte_id

		column regra_alinhamento
			dataType: string
			summarizeBy: none
			sourceColumn: regra_alinhamento

		column situacao_levantamento
			dataType: string
			summarizeBy: none
			sourceColumn: situacao_levantamento

		column cana_mil_t
			dataType: double
			summarizeBy: none
			sourceColumn: cana_mil_t

		column area_plantada_mil_ha
			dataType: double
			summarizeBy: none
			sourceColumn: area_plantada_mil_ha

		column producao_acucar_mil_t
			dataType: double
			summarizeBy: none
			sourceColumn: producao_acucar_mil_t

		column producao_etanol_anidro_mil_l
			dataType: double
			summarizeBy: none
			sourceColumn: producao_etanol_anidro_mil_l

		column producao_etanol_hidratado_mil_l
			dataType: double
			summarizeBy: none
			sourceColumn: producao_etanol_hidratado_mil_l

		column producao_etanol_total_mil_l
			dataType: double
			summarizeBy: none
			sourceColumn: producao_etanol_total_mil_l

		column atr_kg_t
			dataType: double
			summarizeBy: none
			sourceColumn: atr_kg_t

		column mix_etanol_acucar_l_t
			dataType: double
			summarizeBy: none
			sourceColumn: mix_etanol_acucar_l_t

		column intensidade_acucar_t_t
			dataType: double
			summarizeBy: none
			sourceColumn: intensidade_acucar_t_t

		measure 'Mix etanol açúcar (L por t)' = IF(SELECTEDVALUE(dim_territorio[nivel_territorial]) = "uf" && COUNTROWS(FILTER(fato_industria, ISBLANK(fato_industria[producao_etanol_total_mil_l]) || ISBLANK(fato_industria[producao_acucar_mil_t]))) = 0, DIVIDE(SUM(fato_industria[producao_etanol_total_mil_l]), SUM(fato_industria[producao_acucar_mil_t])))
			formatString: 0.0000

		measure 'Intensidade açúcar (t por t)' = IF(SELECTEDVALUE(dim_territorio[nivel_territorial]) = "uf" && COUNTROWS(FILTER(fato_industria, ISBLANK(fato_industria[producao_acucar_mil_t]) || ISBLANK(fato_industria[cana_mil_t]))) = 0, DIVIDE(SUM(fato_industria[producao_acucar_mil_t]), SUM(fato_industria[cana_mil_t])))
			formatString: 0.0000

		measure 'ATR ponderado (kg por t)' = IF(SELECTEDVALUE(dim_territorio[nivel_territorial]) = "uf" && COUNTROWS(FILTER(fato_industria, ISBLANK(fato_industria[atr_kg_t]) || ISBLANK(fato_industria[cana_mil_t]))) = 0, DIVIDE(SUMX(fato_industria, fato_industria[atr_kg_t] * fato_industria[cana_mil_t]), SUM(fato_industria[cana_mil_t])))
			formatString: 0.00

		/// ATR-equivalente do acucar produzido (kg). Premissa CONSECANA: acucar branco 1,0495 kg ATR/kg (CONAB generico; VHP 1,0453 e alternativa a confirmar). Exclusiva do nivel UF.
		measure 'ATR equivalente açúcar (kg)' = IF(SELECTEDVALUE(dim_territorio[nivel_territorial]) = "uf" && NOT ISBLANK(SUM(fato_industria[producao_acucar_mil_t])), SUM(fato_industria[producao_acucar_mil_t]) * 1000000 * 1.0495)
			formatString: #,0

		/// ATR-equivalente do etanol produzido (kg), anidro (1,7651) e hidratado (1,6913) somados SEPARADAMENTE, nunca pelo total. Exclusiva do nivel UF.
		measure 'ATR equivalente etanol (kg)' = IF(SELECTEDVALUE(dim_territorio[nivel_territorial]) = "uf" && NOT ISBLANK(SUM(fato_industria[producao_etanol_anidro_mil_l])) && NOT ISBLANK(SUM(fato_industria[producao_etanol_hidratado_mil_l])), SUM(fato_industria[producao_etanol_anidro_mil_l]) * 1000 * 1.7651 + SUM(fato_industria[producao_etanol_hidratado_mil_l]) * 1000 * 1.6913)
			formatString: #,0

		/// Fatia do acucar no ATR total (ATR acucar / ATR total). DIVIDE protegido; denominador 0/nulo retorna BLANK, nunca 0% nem 50/50. Exclusiva do nivel UF.
		measure 'Share açúcar (ATR)' = VAR AtrAcucar = [ATR equivalente açúcar (kg)] VAR AtrEtanol = [ATR equivalente etanol (kg)] VAR AtrTotal = AtrAcucar + AtrEtanol RETURN IF(NOT ISBLANK(AtrAcucar) && NOT ISBLANK(AtrEtanol) && AtrTotal > 0, DIVIDE(AtrAcucar, AtrTotal))
			formatString: 0.00%

		/// Fatia do etanol no ATR total (ATR etanol / ATR total). DIVIDE protegido; denominador 0/nulo retorna BLANK, nunca 0% nem 50/50. Exclusiva do nivel UF.
		measure 'Share etanol (ATR)' = VAR AtrAcucar = [ATR equivalente açúcar (kg)] VAR AtrEtanol = [ATR equivalente etanol (kg)] VAR AtrTotal = AtrAcucar + AtrEtanol RETURN IF(NOT ISBLANK(AtrAcucar) && NOT ISBLANK(AtrEtanol) && AtrTotal > 0, DIVIDE(AtrEtanol, AtrTotal))
			formatString: 0.00%

		/// Rotulo textual de cobertura: distingue 'sem dado' (cinza/hachura no visual) de 'mix real' (fatia zero legitima) e 'presente'. Medida textual, sem formatString numerico. Exclusiva do nivel UF.
		measure 'Situação mix (UF/safra)' = VAR Cana = SUM(fato_industria[cana_mil_t]) VAR Acucar = SUM(fato_industria[producao_acucar_mil_t]) VAR Etanol = SUM(fato_industria[producao_etanol_total_mil_l]) RETURN SWITCH(TRUE(), ISBLANK(Cana) || Cana = 0, "sem dado", ISBLANK(Acucar) || ISBLANK(Etanol), "sem dado", (Acucar = 0 || Etanol = 0), "mix real", "presente")

		partition fato_industria = m
			mode: import
			source =
				Parquet.Document(Web.Contents("https://raw.githubusercontent.com/brennohdev/canavis-data-visualization-2026.2/main/data/processed/fato_industria.parquet"))

	table fato_vendas_etanol_uf
		column territorio_id
			dataType: string
			summarizeBy: none
			sourceColumn: territorio_id

		column uf
			dataType: string
			summarizeBy: none
			sourceColumn: uf

		column ano_referencia
			dataType: int64
			summarizeBy: none
			sourceColumn: ano_referencia

		column data_referencia
			dataType: dateTime
			summarizeBy: none
			sourceColumn: data_referencia

		column fonte_id
			dataType: string
			summarizeBy: none
			sourceColumn: fonte_id

		column escopo_vendas
			dataType: string
			summarizeBy: none
			sourceColumn: escopo_vendas

		column vendas_etanol_hidratado_l
			dataType: int64
			summarizeBy: none
			sourceColumn: vendas_etanol_hidratado_l

		measure 'Vendas etanol UF (L)' = IF(SELECTEDVALUE(dim_territorio[nivel_territorial]) = "uf", SUM(fato_vendas_etanol_uf[vendas_etanol_hidratado_l]))
			formatString: #,0

		partition fato_vendas_etanol_uf = m
			mode: import
			source =
				Parquet.Document(Web.Contents("https://raw.githubusercontent.com/brennohdev/canavis-data-visualization-2026.2/main/data/processed/fato_vendas_etanol_uf.parquet"))

	table fato_vendas_etanol_municipio
		column uf_id
			dataType: string
			summarizeBy: none
			sourceColumn: uf_id

		column uf
			dataType: string
			summarizeBy: none
			sourceColumn: uf

		column ano_referencia
			dataType: int64
			summarizeBy: none
			sourceColumn: ano_referencia

		column data_referencia
			dataType: dateTime
			summarizeBy: none
			sourceColumn: data_referencia

		column fonte_id
			dataType: string
			summarizeBy: none
			sourceColumn: fonte_id

		column escopo_vendas
			dataType: string
			summarizeBy: none
			sourceColumn: escopo_vendas

		column codigo_municipio_origem
			dataType: string
			summarizeBy: none
			sourceColumn: codigo_municipio_origem

		column nome_municipio_origem
			dataType: string
			summarizeBy: none
			sourceColumn: nome_municipio_origem

		column territorio_id
			dataType: string
			summarizeBy: none
			sourceColumn: territorio_id

		column status_chave
			dataType: string
			summarizeBy: none
			sourceColumn: status_chave

		column vendas_etanol_hidratado_l
			dataType: int64
			summarizeBy: none
			sourceColumn: vendas_etanol_hidratado_l

		/// Vendas de etanol hidratado (L). A versao municipal so e confiavel dentro da PB (chave conferida).
		measure 'Vendas etanol municípios validados (L)' = IF(SELECTEDVALUE(dim_territorio[nivel_territorial]) = "municipio", SUM(fato_vendas_etanol_municipio[vendas_etanol_hidratado_l]))
			formatString: #,0

		partition fato_vendas_etanol_municipio = m
			mode: import
			source =
				Parquet.Document(Web.Contents("https://raw.githubusercontent.com/brennohdev/canavis-data-visualization-2026.2/main/data/processed/fato_vendas_etanol_municipio.parquet"))

	table dim_territorio
		column territorio_id
			dataType: string
			summarizeBy: none
			sourceColumn: territorio_id

		column cod_local
			dataType: string
			summarizeBy: none
			sourceColumn: cod_local

		column nome_territorio
			dataType: string
			summarizeBy: none
			sourceColumn: nome_territorio

		column nivel_territorial
			dataType: string
			summarizeBy: none
			sourceColumn: nivel_territorial

		column cod_municipio
			dataType: string
			summarizeBy: none
			sourceColumn: cod_municipio

		column cod_microrregiao
			dataType: string
			summarizeBy: none
			sourceColumn: cod_microrregiao

		column cod_regiao_imediata
			dataType: string
			summarizeBy: none
			sourceColumn: cod_regiao_imediata

		column nome_regiao_imediata
			dataType: string
			summarizeBy: none
			sourceColumn: nome_regiao_imediata

		column cod_regiao_intermediaria
			dataType: string
			summarizeBy: none
			sourceColumn: cod_regiao_intermediaria

		column nome_regiao_intermediaria
			dataType: string
			summarizeBy: none
			sourceColumn: nome_regiao_intermediaria

		column cod_uf
			dataType: string
			summarizeBy: none
			sourceColumn: cod_uf

		column mapeamento_regiao_2017
			dataType: string
			summarizeBy: none
			sourceColumn: mapeamento_regiao_2017

		column tier
			dataType: string
			summarizeBy: none
			sourceColumn: tier

		partition dim_territorio = m
			mode: import
			source =
				Parquet.Document(Web.Contents("https://raw.githubusercontent.com/brennohdev/canavis-data-visualization-2026.2/main/data/processed/dim_territorio.parquet"))

	table dim_calendario
		dataCategory: Time
		column data_referencia
			dataType: dateTime
			summarizeBy: none
			sourceColumn: data_referencia
			isKey
			formatString: yyyy-MM-dd

		column ano
			dataType: int64
			summarizeBy: none
			sourceColumn: ano

		column mes
			dataType: int64
			summarizeBy: none
			sourceColumn: mes

		column trimestre
			dataType: int64
			summarizeBy: none
			sourceColumn: trimestre

		column dia
			dataType: int64
			summarizeBy: none
			sourceColumn: dia

		partition dim_calendario = m
			mode: import
			source =
				Parquet.Document(Web.Contents("https://raw.githubusercontent.com/brennohdev/canavis-data-visualization-2026.2/main/data/processed/dim_calendario.parquet"))

	table dim_fonte
		column fonte_id
			dataType: string
			summarizeBy: none
			sourceColumn: fonte_id

		column fonte
			dataType: string
			summarizeBy: none
			sourceColumn: fonte

		column tabela
			dataType: string
			summarizeBy: none
			sourceColumn: tabela

		column periodicidade
			dataType: string
			summarizeBy: none
			sourceColumn: periodicidade

		column unidade_quantidade
			dataType: string
			summarizeBy: none
			sourceColumn: unidade_quantidade

		column unidade_area
			dataType: string
			summarizeBy: none
			sourceColumn: unidade_area

		column url
			dataType: string
			summarizeBy: none
			sourceColumn: url

		partition dim_fonte = m
			mode: import
			source =
				Parquet.Document(Web.Contents("https://raw.githubusercontent.com/brennohdev/canavis-data-visualization-2026.2/main/data/processed/dim_fonte.parquet"))

	relationship fato_dim_territorio
		fromColumn: fato_producao.territorio_id
		toColumn: dim_territorio.territorio_id
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection

	relationship fato_dim_calendario
		fromColumn: fato_producao.data_referencia
		toColumn: dim_calendario.data_referencia
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection

	relationship fato_dim_fonte
		fromColumn: fato_producao.fonte_id
		toColumn: dim_fonte.fonte_id
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection

	relationship fato_industria_dim_territorio
		fromColumn: fato_industria.territorio_id
		toColumn: dim_territorio.territorio_id
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection

	relationship fato_industria_dim_calendario
		fromColumn: fato_industria.data_referencia
		toColumn: dim_calendario.data_referencia
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection

	relationship fato_industria_dim_fonte
		fromColumn: fato_industria.fonte_id
		toColumn: dim_fonte.fonte_id
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection

	relationship fato_vendas_etanol_uf_dim_territorio
		fromColumn: fato_vendas_etanol_uf.territorio_id
		toColumn: dim_territorio.territorio_id
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection

	relationship fato_vendas_etanol_uf_dim_calendario
		fromColumn: fato_vendas_etanol_uf.data_referencia
		toColumn: dim_calendario.data_referencia
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection

	relationship fato_vendas_etanol_uf_dim_fonte
		fromColumn: fato_vendas_etanol_uf.fonte_id
		toColumn: dim_fonte.fonte_id
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection

	relationship fato_vendas_etanol_municipio_dim_territorio
		fromColumn: fato_vendas_etanol_municipio.territorio_id
		toColumn: dim_territorio.territorio_id
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection

	relationship fato_vendas_etanol_municipio_dim_calendario
		fromColumn: fato_vendas_etanol_municipio.data_referencia
		toColumn: dim_calendario.data_referencia
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection

	relationship fato_vendas_etanol_municipio_dim_fonte
		fromColumn: fato_vendas_etanol_municipio.fonte_id
		toColumn: dim_fonte.fonte_id
		fromCardinality: many
		toCardinality: one
		crossFilteringBehavior: oneDirection
